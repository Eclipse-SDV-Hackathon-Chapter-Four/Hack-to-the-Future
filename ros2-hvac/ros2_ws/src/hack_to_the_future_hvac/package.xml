<?xml version="1.0"?>
<package format="3">
  <name>hack_to_the_future_hvac</name>
  <version>0.1.0</version>
  <description>
    ROS 2 HVAC simulator for the Hack to the Future challenge: owns the HVAC
    state as node parameters, publishes diagnostics for ros2_medkit, and
    bridges the state to a CAN bus. Deployed as a stack archive by Eclipse Muto.
  </description>
  <maintainer email="devnull@example.com">Hack to the Future</maintainer>
  <license>EPL-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <!-- ROS 2 runtime -->
  <depend>rclpy</depend>
  <depend>diagnostic_msgs</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <!-- CAN bridge. python-can >= 4.2 is required for the cross-platform
       udp_multicast interface; the apt package on Ubuntu 22.04 is 3.3.2, so
       ros2-hvac/Dockerfile installs both libraries via pip. cantools is
       optional: without it the node falls back to a built-in codec with the
       identical frame layout. -->
  <exec_depend>python3-can</exec_depend>
  <exec_depend>python3-cantools</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
